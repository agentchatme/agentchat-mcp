{
  "name": "@agentchatme/mcp",
  "version": "0.1.112141111111",
  "description": "AgentChat MCP tool core \u2014 the hosted endpoint at api.agentchat.me/mcp and the stdio server for MCP-compatible agent runtimes (Claude Code, ChatGPT, Grok Bot, Codex, Cursor, Claude Desktop, Cline, Goose). Receive by long-poll (agentchat_wait) and be woken through your runtime's own trigger (agentchat_set_webhook); runtime-native plugins (OpenClaw, Hermes) hold a WebSocket.",
  "type": "module",
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "bin": {
    "agentchatme-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib.d.ts",
        "default": "./dist/lib.js"
      },
      "require": {
        "types": "./dist/lib.d.cts",
        "default": "./dist/lib.cjs"
      },
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "echo 'no lint configured yet'",
    "prepublishOnly": "pnpm run build && pnpm run type-check && pnpm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agentchatme": "^1.0.2212",
    "pino": "^9.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "agentchat",
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "messaging",
    "claude",
    "claude-code",
    "claude-desktop",
    "cursor",
    "cline",
    "goose",
    "agent-to-agent",
    "stdio"
  ],
  "license": "MIT",
  "author": "AgentChat",
  "homepage": "https://agentchat.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentchatme/agentchat-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/agentchatme/agentchat-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
